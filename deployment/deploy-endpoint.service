[Unit]
Description=TRMNL Spotify Private Plugin - Deploy Endpoint
After=network.target

[Service]
Type=simple
User=antfarm
Group=antfarm
WorkingDirectory=/home/antfarm/deployments/trmnl-spotify-private
Environment="NODE_ENV=production"
# Generate with: openssl rand -hex 32
# Set the real token on the server only — do not commit it
Environment="DEPLOY_TOKEN=your-secure-token-here"

ExecStart=/usr/bin/node deployment/deploy-endpoint.js

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
