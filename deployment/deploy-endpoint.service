[Unit]
Description=TRMNL Spotify Private Plugin - Deploy Endpoint
After=network.target

[Service]
Type=simple
User=antfarm
WorkingDirectory=/home/antfarm/deployments/trmnl-spotify-private
ExecStart=/usr/bin/node deployment/deploy-endpoint.js
Restart=on-failure
RestartSec=10
Environment=NODE_ENV=production
# Generate a deploy token: openssl rand -hex 32
# Set it here and in the n8n webhook that triggers deploys.
Environment=DEPLOY_TOKEN=REPLACE_WITH_REAL_TOKEN

[Install]
WantedBy=multi-user.target
