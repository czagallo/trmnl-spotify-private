[Unit]
Description=TRMNL Spotify Private Plugin
After=network.target

[Service]
Type=simple
User=antfarm
Group=antfarm
WorkingDirectory=/home/antfarm/deployments/trmnl-spotify-private
Environment="NODE_ENV=production"
Environment="PORT=3006"

ExecStartPre=/usr/local/bin/kill_port.sh 3006
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/node server.js
ExecStop=/usr/local/bin/kill_port.sh 3006

KillMode=mixed
SendSIGKILL=yes
TimeoutStopSec=5
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
